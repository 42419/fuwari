---
import { Icon } from "astro-icon/components";
import type { MarkdownHeading } from "astro";
import TOC from "../widget/TOC.astro";
import { siteConfig } from "../../config";
import { i18n } from "../../i18n/translation";
import I18nKey from "../../i18n/i18nKey";
import { url } from "../../utils/url-utils";

interface Props {
    headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const isPost = Astro.url.pathname.startsWith(url('/posts/'));
---
{(siteConfig.toc.enable && isPost) ? <mobile-toc-widget id="mobile-toc-wrapper" class="block lg:hidden">
    <div id="mobile-toc-btn" class="fixed bottom-20 right-3 z-50 flex items-center justify-center rounded-2xl overflow-hidden transition shadow-xl border border-black/5 dark:border-white/5 active:scale-95">
        <button aria-label={i18n(I18nKey.toc)} class="btn-card h-[3.5rem] w-[3.5rem] md:h-[3.75rem] md:w-[3.75rem] flex items-center justify-center">
            <Icon name="material-symbols:list-rounded" class="text-[1.5rem] md:text-[1.75rem] text-[var(--primary)]"></Icon>
        </button>
    </div>
    <div id="mobile-toc-panel" class="fixed bottom-20 right-3 w-72 max-w-[85vw] h-[55vh] rounded-2xl shadow-2xl scale-0 opacity-0 origin-bottom-right transition-all duration-300 ease-[cubic-bezier(0.2,1.1,0.4,1)] z-50 overflow-hidden bg-white/70 dark:bg-[#1a1a1a]/70 backdrop-blur-xl border border-black/5 dark:border-white/5">
        <div class="flex flex-col h-full">
            <div class="px-4 md:px-5 py-3 flex justify-between items-center border-b border-[var(--line-divider)]">
                <span class="font-bold text-lg text-neutral-900 dark:text-neutral-100">{i18n(I18nKey.toc)}</span>
                <button id="mobile-toc-close" class="btn-plain w-8 h-8 rounded-lg flex items-center justify-center">
                   <Icon name="material-symbols:close-rounded" class="text-xl"></Icon>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto overflow-x-hidden hide-scrollbar px-3 md:px-4 py-3 toc-scroll-container">
                 <TOC headings={headings}></TOC>
            </div>
        </div>
    </div>
    <div id="mobile-toc-overlay" class="fixed inset-0 bg-black/50 z-40 opacity-0 pointer-events-none transition-opacity duration-300"></div>
</mobile-toc-widget> : <div id="mobile-toc-wrapper" class="block lg:hidden"></div>}

<script>
    class MobileTOCWidget extends HTMLElement {
        constructor() {
            super();
        }

        connectedCallback() {
            const btn = this.querySelector('#mobile-toc-btn');
            const panel = this.querySelector('#mobile-toc-panel');
            const overlay = this.querySelector('#mobile-toc-overlay');
            const closeBtn = this.querySelector('#mobile-toc-close');

            const toggleMenu = () => {
                if (!panel || !overlay) return;
                const isOpen = !panel.classList.contains('scale-0');
                if (isOpen) {
                    panel.classList.add('scale-0', 'opacity-0');
                    panel.classList.remove('scale-100', 'opacity-100');
                    overlay.classList.add('opacity-0', 'pointer-events-none');
                    document.body.style.overflow = '';
                } else {
                    panel.classList.remove('scale-0', 'opacity-0');
                    panel.classList.add('scale-100', 'opacity-100');
                    overlay.classList.remove('opacity-0', 'pointer-events-none');
                    document.body.style.overflow = 'hidden';

                    // Trigger TOC update when panel opens
                    setTimeout(() => {
                        const toc = panel.querySelector('table-of-contents');
                        if (toc) {
                            (toc as any).update();
                        }
                    }, 350); // wait for transition to finish
                }
            }

            btn?.addEventListener('click', toggleMenu);
            closeBtn?.addEventListener('click', toggleMenu);
            overlay?.addEventListener('click', toggleMenu);

            const links = panel?.querySelectorAll('a');
            links?.forEach(link => {
                link.addEventListener('click', toggleMenu);
            });
        }
    }

    if (!customElements.get('mobile-toc-widget')) {
        customElements.define('mobile-toc-widget', MobileTOCWidget);
    }
</script>