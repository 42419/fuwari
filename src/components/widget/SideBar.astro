---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";
import TOC from "./TOC.astro";
import { siteConfig } from "../../config";
import WidgetLayout from "./WidgetLayout.astro";
import { i18n } from "../../i18n/translation";
import I18nKey from "../../i18n/i18nKey";
import { url } from "../../utils/url-utils";

interface Props {
    class?: string;
    headings?: MarkdownHeading[];
}

const { headings, class: className } = Astro.props;
const isPost = Astro.url.pathname.startsWith(url('/posts/'));
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        {!isPost && <Profile></Profile>}
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        {siteConfig.toc.enable && isPost && headings && (
            <WidgetLayout name={i18n(I18nKey.toc)} id="sidebar-toc" class="onload-animation hidden lg:block 2xl:hidden" style="animation-delay: 150ms">
                <div class="h-[20rem] overflow-y-auto overflow-x-hidden hide-scrollbar toc-scroll-container">
                    <TOC headings={headings}></TOC>
                </div>
            </WidgetLayout>
        )}
        <Categories class="onload-animation" style="animation-delay: 200ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 250ms"></Tag>
    </div>
</div>
